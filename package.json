{
  "name": "mobai",
  "version": "0.2.0",
  "private": true,
  "description": "墨白：个人 Markdown 编辑器",
  "author": "墨白",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json",
    "site": "npx --yes serve website -p 4173",
    "dist:mac": "pnpm build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-code-block": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-table-cell": "3.32.0",
    "@tiptap/extension-table-header": "3.32.0",
    "@tiptap/extension-table-row": "3.32.0",
    "@tiptap/extension-task-item": "3.32.0",
    "@tiptap/extension-task-list": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/vue-3": "3.32.0",
    "codemirror": "^6.0.2",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "pinia": "3.0.3",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.7.2",
    "@vitejs/plugin-vue": "6.0.1",
    "electron": "44.7.2",
    "electron-builder": "26.0.12",
    "electron-vite": "6.0.0",
    "happy-dom": "20.0.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.0.15",
    "vue-tsc": "3.1.1"
  },
  "build": {
    "appId": "app.mobai.editor",
    "productName": "墨白",
    "copyright": "Copyright © 墨白",
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mmd", "mdown", "mkd", "mdwn", "mdtxt", "mdtext", "rmarkdown", "rmd", "qmd", "apib", "mdx"],
        "name": "Markdown",
        "description": "Markdown 文档",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": ["txt", "text"],
        "name": "纯文本",
        "description": "纯文本",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "textpack",
        "name": "TextPack",
        "description": "TextPack 文档",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": "textbundle",
        "name": "TextBundle",
        "description": "TextBundle 文档",
        "role": "Editor",
        "rank": "Alternate",
        "isPackage": true
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Markdown",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Alternate",
            "LSItemContentTypes": ["net.daringfireball.markdown"]
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "net.daringfireball.markdown",
            "UTTypeDescription": "Markdown 文档",
            "UTTypeConformsTo": ["public.plain-text"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["md", "markdown", "mmd", "mdown", "mkd", "mdwn", "mdtxt", "mdtext", "rmarkdown", "rmd", "qmd", "apib", "mdx"],
              "public.mime-type": ["text/markdown"]
            }
          }
        ]
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "mobai-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "墨白 ${version}"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
